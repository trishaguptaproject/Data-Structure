from collections import defaultdict
import tkinter as tk
from tkinter import messagebox


# Graph Class

class Graph:

    def __init__(self):
        self.graph = defaultdict(list)

    def add_vertex(self, vertex):
        if vertex not in self.graph:
            self.graph[vertex] = []

    def add_edge(self, vertex1, vertex2):
        if vertex1 in self.graph and vertex2 in self.graph:
            self.graph[vertex1].append(vertex2)
            self.graph[vertex2].append(vertex1)

    def dfs_tree(self, start):
        visited = set()
        dfs_tree = defaultdict(list)
        traversal = []

        def dfs(vertex):
            visited.add(vertex)
            traversal.append(vertex)

            for neighbor in self.graph[vertex]:
                if neighbor not in visited:
                    dfs_tree[vertex].append(neighbor)
                    dfs(neighbor)

        dfs(start)

        return dfs_tree, traversal


# Global Graph

g = Graph()


# Add Vertex

def add_vertex():
    vertex = vertex_entry.get().strip().upper()

    if vertex == "":
        messagebox.showerror(
            "Error",
            "Please enter a vertex."
        )
        return

    if vertex in g.graph:
        messagebox.showwarning(
            "Warning",
            "Vertex already exists."
        )
        return

    g.add_vertex(vertex)

    vertex_entry.delete(0, tk.END)

    display_graph()


# Add Edge

def add_edge():
    vertex1 = vertex1_entry.get().strip().upper()
    vertex2 = vertex2_entry.get().strip().upper()

    if vertex1 == "" or vertex2 == "":
        messagebox.showerror(
            "Error",
            "Please enter both vertices."
        )
        return

    if vertex1 not in g.graph or vertex2 not in g.graph:
        messagebox.showerror(
            "Error",
            "Both vertices must exist first."
        )
        return

    if vertex1 == vertex2:
        messagebox.showerror(
            "Error",
            "A vertex cannot be connected to itself."
        )
        return

    if vertex2 in g.graph[vertex1]:
        messagebox.showwarning(
            "Warning",
            "This edge already exists."
        )
        return

    g.add_edge(vertex1, vertex2)

    vertex1_entry.delete(0, tk.END)
    vertex2_entry.delete(0, tk.END)

    display_graph()


# Perform DFS

def perform_dfs():
    start = start_entry.get().strip().upper()

    if start == "":
        messagebox.showerror(
            "Error",
            "Please enter a starting vertex."
        )
        return

    if start not in g.graph:
        messagebox.showerror(
            "Error",
            "Starting vertex does not exist."
        )
        return

    dfs_result, traversal = g.dfs_tree(start)

    for widget in dfs_result_frame.winfo_children():
        widget.destroy()

    heading = tk.Label(
        dfs_result_frame,
        text="DEPTH-FIRST TREE",
        font=("Arial", 14, "bold"),
        bg="#FFFFFF",
        fg="#8A6D00"
    )
    heading.pack(pady=5)

    traversal_label = tk.Label(
        dfs_result_frame,
        text="DFS Traversal: " + " → ".join(traversal),
        font=("Arial", 11, "bold"),
        bg="#FFF59D",
        fg="#5D4E00",
        padx=10,
        pady=7
    )
    traversal_label.pack(
        pady=3,
        padx=15,
        fill="x"
    )

    for vertex in dfs_result:
        children = dfs_result[vertex]

        row = tk.Frame(
            dfs_result_frame,
            bg="#FFFDE7"
        )
        row.pack(
            fill="x",
            padx=20,
            pady=2
        )

        parent_label = tk.Label(
            row,
            text=vertex,
            font=("Arial", 10, "bold"),
            width=7,
            bg="#F4C430",
            fg="white"
        )
        parent_label.pack(
            side="left",
            padx=3,
            pady=3
        )

        child_text = ", ".join(children)

        child_label = tk.Label(
            row,
            text="→  " + child_text,
            font=("Arial", 10, "bold"),
            bg="#FFF9C4",
            fg="#5D4E00",
            anchor="w"
        )
        child_label.pack(
            side="left",
            fill="x",
            expand=True,
            padx=3,
            pady=3
        )


# Display Graph

def display_graph():
    for widget in graph_result_frame.winfo_children():
        widget.destroy()

    heading = tk.Label(
        graph_result_frame,
        text="CURRENT GRAPH",
        font=("Arial", 13, "bold"),
        bg="#FFFFFF",
        fg="#8A6D00"
    )
    heading.pack(pady=4)

    for vertex, edges in g.graph.items():

        if edges:
            edge_text = ", ".join(edges)
        else:
            edge_text = "No edges"

        row = tk.Frame(
            graph_result_frame,
            bg="#FFF9C4"
        )
        row.pack(
            fill="x",
            padx=20,
            pady=1
        )

        vertex_label = tk.Label(
            row,
            text=vertex,
            font=("Arial", 10, "bold"),
            width=6,
            bg="#F4C430",
            fg="white"
        )
        vertex_label.pack(
            side="left",
            padx=3,
            pady=2
        )

        edges_label = tk.Label(
            row,
            text=edge_text,
            font=("Arial", 10),
            bg="#FFF9C4",
            fg="#5D4E00",
            anchor="w"
        )
        edges_label.pack(
            side="left",
            fill="x",
            expand=True,
            padx=3
        )


# Clear All

def clear_all():
    global g

    g = Graph()

    vertex_entry.delete(0, tk.END)
    vertex1_entry.delete(0, tk.END)
    vertex2_entry.delete(0, tk.END)
    start_entry.delete(0, tk.END)

    for widget in graph_result_frame.winfo_children():
        widget.destroy()

    for widget in dfs_result_frame.winfo_children():
        widget.destroy()


