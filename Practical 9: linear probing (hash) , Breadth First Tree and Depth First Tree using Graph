# Get BFS Traversal

def get_bfs_traversal(start):
    visited = set()
    queue = deque([start])
    traversal = []

    visited.add(start)

    while queue:
        current = queue.popleft()
        traversal.append(current)

        for neighbor in g.graph[current]:
            if neighbor not in visited:
                visited.add(neighbor)
                queue.append(neighbor)

    return traversal


