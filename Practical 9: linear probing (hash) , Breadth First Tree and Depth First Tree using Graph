        if data_input == "":
            messagebox.showerror(
                "Invalid Input",
                "Please enter data."
            )
            return

        # Convert input into integers
        data = list(map(int, data_input.split()))

        # Create empty hash table
        hash_table = [None] * hash_size

        # Insert each value using linear probing
        for value in data:

            # Calculate initial hash index
            hash_index = value % hash_size

            original_index = hash_index

            # Linear probing
            while hash_table[hash_index] is not None:

                hash_index = (hash_index + 1) % hash_size

                # Check if table is full
                if hash_index == original_index:
                    messagebox.showwarning(
                        "Hash Table Full",
                        "Hash table is full!\n"
                        "Some values could not be inserted."
                    )

                    display_table(hash_table)
                    return

            # Insert value
            hash_table[hash_index] = value

        # Display final table
        display_table(hash_table)

    except ValueError:
        messagebox.showerror(
            "Invalid Input",
            "Please enter valid numbers only.\n\n"
            "Example: 10 15 7 12"
        )

