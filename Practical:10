#CL Code:
# Program to implement Hash Table
# Operations: Insertion, Deletion and Traversal
# Assumption: No collisions  

SIZE = 10

# Create an empty hash table
hash_table = [None] * SIZE


# Hash function
def hash_function(key):
    return key % SIZE


# Insert an element
def insert(key):
    index = hash_function(key)

    if hash_table[index] is None:
        hash_table[index] = key
        print("Element inserted successfully.")
    else:
        print("Collision occurred! Cannot insert.")


# Delete an element
def delete(key):
    index = hash_function(key)

    if hash_table[index] == key:
        hash_table[index] = None
        print("Element deleted successfully.")
    else:
        print("Element not found.")


# Traverse the hash table
def traverse():
    print("\nHash Table:")
    for i in range(SIZE):
        print("Index", i, ":", hash_table[i])


# Main program
while True:
    print("\n--- HASH TABLE MENU ---")
    print("1. Insert")
    print("2. Delete")
    print("3. Traverse")
    print("4. Exit")

    choice = int(input("Enter your choice: "))

    if choice == 1:
        key = int(input("Enter element to insert: "))
        insert(key)

    elif choice == 2:
        key = int(input("Enter element to delete: "))
        delete(key)

    elif choice == 3:
        traverse()

    elif choice == 4:
        print("Program terminated.")
        break

    else:
        print("Invalid choice!")


#GUI CODE:
import tkinter as tk
from tkinter import messagebox

# Hash Table settings
SIZE = 10
hash_table = [None] * SIZE


# Hash Function
def hash_function(key):
    return key % SIZE


# Insert Function
def insert():
    try:
        key = int(entry.get())
        index = hash_function(key)

        if hash_table[index] is None:
            hash_table[index] = key
            messagebox.showinfo("Success", "Element inserted successfully!")
            entry.delete(0, tk.END)
            display_table()
        else:
            messagebox.showwarning(
                "Collision",
                "Collision occurred! Cannot insert."
            )

    except ValueError:
        messagebox.showerror("Error", "Please enter a valid integer.")


# Delete Function
def delete():
    try:
        key = int(entry.get())
        index = hash_function(key)

        if hash_table[index] == key:
            hash_table[index] = None
            messagebox.showinfo("Success", "Element deleted successfully!")
            entry.delete(0, tk.END)
            display_table()
        else:
            messagebox.showwarning("Not Found", "Element not found.")

    except ValueError:
        messagebox.showerror("Error", "Please enter a valid integer.")


# Display / Traversal Function
def display_table():
    output.delete("1.0", tk.END)

    output.insert(tk.END, "HASH TABLE\n")
    output.insert(tk.END, "----------------------\n")

    for i in range(SIZE):
        if hash_table[i] is None:
            output.insert(tk.END, "Index " + str(i) + " : Empty\n")
        else:
            output.insert(
                tk.END,
                "Index " + str(i) + " : " + str(hash_table[i]) + "\n"
            )


# Clear Function
def clear_table():
    global hash_table
    hash_table = [None] * SIZE
    display_table()


